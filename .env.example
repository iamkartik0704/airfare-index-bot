# ============================================================================
# SAFAR (APIx) backend — copy to .env and fill in. Never commit .env.
# All settings: packages/config/settings.py (prefix SAFAR_, nesting with __).
# ============================================================================
SAFAR_ENVIRONMENT=development          # development | test | production
SAFAR_LOG_LEVEL=INFO
SAFAR_LOG_JSON=true

# --- Database (docker compose builds SAFAR_DATABASE_URL from these) ---------
SAFAR_DB_USER=safar
SAFAR_DB_PASSWORD=change-me-local-only
SAFAR_DB_NAME=safar
# For running outside docker (defaults to SQLite at var/safar.db if unset):
# SAFAR_DATABASE_URL=postgresql+psycopg://safar:change-me-local-only@localhost:5432/safar

# --- Evidence store (raw response bodies) -----------------------------------
# SAFAR_EVIDENCE_DIR=./var/evidence

# --- Sources -----------------------------------------------------------------
# The synthetic market simulator (clearly labelled "simulated" everywhere).
SAFAR_SIMULATED_SOURCE_ENABLED=true
# Descriptive bot identity (doc 15). Must contain "bot".
# SAFAR_SCRAPING__USER_AGENT=MoSPI-SAFAR-Bot/1.0 (+https://mospi.gov.in/safar)
# SAFAR_SCRAPING__ROBOTS_FAIL_CLOSED=true
# Optional operator-approved egress proxies (JSON list). Empty = direct.
# SAFAR_SCRAPING__PROXIES=[]

# --- Worker / scheduler -------------------------------------------------------
# SAFAR_WORKER__CONCURRENCY=4
# SAFAR_WORKER__METRICS_PORT=9100
# SAFAR_SCHEDULER__SWEEP_CRON=0 1 * * *
# SAFAR_SCHEDULER__INDEX_CRON=30 6 * * *

# --- Index methodology ---------------------------------------------------------
# Fix the base period for publication (otherwise the first 7 priced days are used).
# SAFAR_INDEX__BASE_PERIOD_START=2026-09-01
# SAFAR_INDEX__BASE_PERIOD_END=2026-09-07
# SAFAR_INDEX__HEDONIC_ADJUSTMENT=true

# --- API ----------------------------------------------------------------------
# Keys for operator/bulk endpoints (JSON list). Required when SAFAR_ENVIRONMENT=production.
SAFAR_API__API_KEYS=["change-me-local-api-key"]
SAFAR_API__CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ============================================================================
# Legacy Convex prototype in ./src (not part of the SAFAR stack)
# ============================================================================
VITE_CONVEX_URL=
CONVEX_SITE_URL=http://localhost:5173
CONVEX_DEPLOYMENT=
